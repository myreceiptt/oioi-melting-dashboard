ETHEREUM_SEPOLIA_OIOI_TOKEN=

# Mainnet $OiOi token addresses
BASE_OIOI_TOKEN=
ETH_OIOI_TOKEN=

# Reward claim guard
# Sepolia/testnet reward claim can stay enabled because the testnet reward flow is validated.
NEXT_PUBLIC_SEPOLIA_REWARD_CLAIM_ENABLED=true

# Mainnet reward claim must stay disabled until mainnet reward/indexer/proof flow is validated.
NEXT_PUBLIC_MAINNET_REWARD_CLAIM_ENABLED=false

# Indexer optional tuning
# For Alchemy Free tier, keep INDEXER_BLOCK_RANGE small.
# TO_BLOCK is optional. Leave blank to sync until latest safe block.
INDEXER_LOOKBACK_BLOCKS=
INDEXER_BLOCK_RANGE=10
INDEXER_REQUEST_DELAY_MS=250
INDEXER_WORKER_BLOCK_SPAN=100
INDEXER_WORKER_COMMAND_TIMEOUT_MS=55000
INDEXER_WORKER_RETRY_DELAY_SECONDS=60
INDEXER_WORKER_RATE_LIMIT_DELAY_SECONDS=300
INDEXER_WORKER_LOCK_TTL_SECONDS=120

# Testnet worker auth/cron secret
INDEXER_CRON_SECRET=

# Mainnet worker auth/cron secret
MAINNET_INDEXER_CRON_SECRET=

# Indexer manual start blocks
# Fill FROM_BLOCK from the earliest contract creation block for each chain.
# Testnet from/to blocks
#Create: TheRotyMemorial Contract
BASE_SEPOLIA_INDEXER_FROM_BLOCK=
BASE_SEPOLIA_INDEXER_TO_BLOCK=

#Create: TheRotyMemorial Contract
ETHEREUM_SEPOLIA_INDEXER_FROM_BLOCK=
ETHEREUM_SEPOLIA_INDEXER_TO_BLOCK=

# Mainnet from/to blocks
#Create: TheRotyMemorial Contract
BASE_MAINNET_INDEXER_FROM_BLOCK=
BASE_MAINNET_INDEXER_TO_BLOCK=

#Create: TheRotyMemorial Contract
ETHEREUM_MAINNET_INDEXER_FROM_BLOCK=
ETHEREUM_MAINNET_INDEXER_TO_BLOCK=

